PORT=3000
ERP_MODE=demo
AUTH_REQUIRED=true
JWT_SECRET=dev-local-secret-change-me
ERP_BASE_URL=
ERP_API_KEY=
# Production: set NODE_ENV=production, a unique JWT_SECRET, and never AUTH_REQUIRED=false.
# Optional document AI (disabled unless URL is set; existing regex extraction still runs):
DOCUMENT_AI_URL=
DOCUMENT_AI_KEY=
DOCUMENT_AI_SEND_FILE=false
TRUST_PROXY=false

# Calibrated auto-post is off unless both flags are true. EXECUTE posts without the UI Post action.
AUTO_POST_ENABLED=false
AUTO_POST_EXECUTE=false

# Drop files into this directory when INBOX_WATCH=true (same extract → match path).
INBOX_DIR=
INBOX_WATCH=false

STORAGE_DRIVER=local
S3_PUT_URL=
S3_PUBLIC_URL=
CLAMAV_URL=
REDIS_URL=

OIDC_AUTHORIZE_URL=
OIDC_CLIENT_ID=
OIDC_REDIRECT_URI=
OIDC_SCOPE=openid email profile
